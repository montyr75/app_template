rules_version = '2';

// The deny-all baseline. Each feature that writes Firestore adds its own match blocks here, together with ALLOW and
// DENY cases in the rules suite (docs/testing.md), and `tool\emulators\test.cmd` is the gate for every change to this
// file. Strategy: ARCHITECTURE.md §8.2.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
